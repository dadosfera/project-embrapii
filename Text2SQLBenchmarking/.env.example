# Caminho do projeto no host. O valor relativo "." usa a raiz do Compose.
PROJECT_ROOT=.

# Obrigatórios: preencha com `id -u` e `id -g` do usuário do host.
HOST_UID=
HOST_GID=

# Device CDI do backend. Em host multi-GPU, use por exemplo nvidia.com/gpu=0
# ou outro identificador retornado por `nvidia-ctk cdi list`.
NVIDIA_VISIBLE_DEVICES=nvidia.com/gpu=all

# Token opcional do Hugging Face; deixe vazio para modelos públicos já presentes.
HF_TOKEN=

# JABUTI-SQL (id interno: datasus). Defina somente os campos que deseja sobrescrever.
# DATASUS_DB_HOST=host.docker.internal
# DATASUS_DB_PORT=
# DATASUS_DB_NAME=
# DATASUS_DB_USER=
# DATASUS_DB_PASSWORD=

# SIH/DataSUS (id interno: sih_database).
# SIH_DATABASE_DB_HOST=host.docker.internal
# SIH_DATABASE_DB_PORT=
# SIH_DATABASE_DB_NAME=
# SIH_DATABASE_DB_USER=
# SIH_DATABASE_DB_PASSWORD=

# Overrides opcionais. VANNA_MAX_NEW_TOKENS usa 4096 quando ausente.
# CHAT_RESULT_TTL_SECONDS=900
# VANNA_MAX_NEW_TOKENS=4096
# XIYAN_PROMPT_LANG=cn

# Configuração usada pelo Docker Compose.
DB_HOST=host.docker.internal
DB_PORT=5433
DB_NAME=nome_do_banco
DB_USER=usuario
DB_PASSWORD=senha

# Porta pública do dashboard e origem permitida ao acessar a API diretamente.
DASHBOARD_PORT=8080
CORS_ORIGINS=http://localhost:8080

# Túnel SSH para o Postgres da UFMG (scripts/tunnel.sh). Não commitar valores reais.
SSH_HOST=
SSH_USER=
SSH_PASSWORD=

# Snowflake do dadosferademo (backend/snowflake_conn.py).
SNOWFLAKE_SECRET_FILE=
SNOWFLAKE_SCHEMA=
